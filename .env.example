# Relay — Production Environment Variables Configuration

# -----------------------------------------------------------------------------
# Resend Email Integration (Required for Free Website Audit form)
# -----------------------------------------------------------------------------
# Obtain your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# The verified sender address in your Resend account.
# For testing with Resend without a custom domain, use: onboarding@resend.dev
# In production with a verified domain: Relay Audits <audits@yourdomain.com>
RESEND_FROM_EMAIL=Relay Audits <onboarding@resend.dev>

# The business inbox where new website audit notifications are delivered:
AUDIT_NOTIFICATION_EMAIL=relaystudio.team@gmail.com

# -----------------------------------------------------------------------------
# General Site Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://relay-iota-tawny.vercel.app
